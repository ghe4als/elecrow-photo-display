# WiFi credentials - copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.
#
# Used by scripts/load_env.py (a PlatformIO extra_script) to inject
# WIFI_SSID/WIFI_PASS as build flags. Falls back to include/wifi_config.h
# (CHANGE_ME) if a var is absent, which makes the firmware skip WiFi.
WIFI_SSID=Brook
WIFI_PASS=brook123